# 待 VPS 改版更新
# Caddy v2。示例域名须在私有部署配置中替换。
# 只公开 MCP。显示页、WebSocket 和配对留在本机端口，不经过这个站点。
vr.example.com {
    tls {
        issuer acme {
            # 使用 ACME issuer 默认的 Let's Encrypt 生产目录。
        }
    }

    handle /mcp {
        reverse_proxy localhost:8788 {
            flush_interval -1
        }
    }

    handle {
        respond "未找到" 404
    }
}
